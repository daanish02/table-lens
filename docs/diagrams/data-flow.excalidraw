    {"type":"text","id":"title3","x":40,"y":20,"width":400,"height":34,"text":"Data Flow — Ask a Question","fontSize":28,"strokeColor":"#1e1e1e"},
    {"type":"text","id":"subtitle3","x":40,"y":60,"width":700,"height":20,"text":"One request through the query and visualize agents, in order","fontSize":14,"strokeColor":"#868e96"},

    {"type":"rectangle","id":"f1","x":40,"y":140,"width":190,"height":80,"roundness":{"type":3},"backgroundColor":"#a5d8ff","fillStyle":"solid","strokeColor":"#1971c2","strokeWidth":1.5},
    {"type":"text","id":"f1l","x":55,"y":160,"width":160,"height":40,"text":"Question\n(natural language)","fontSize":15,"containerId":"f1","textAlign":"center"},

